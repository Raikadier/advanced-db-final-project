		sourceColumn: territorio_id

	column cantidad
		dataType: int64
		formatString: "#,##0"
		displayFolder: Métricas
		summarizeBy: sum
		sourceColumn: cantidad

	column unit_price
		dataType: double
		formatString: "$#,##0.00"
		displayFolder: Métricas
		summarizeBy: none
		sourceColumn: unit_price

	column descuento
		dataType: double
		formatString: "0.00%"
		displayFolder: Métricas
		summarizeBy: none
		sourceColumn: descuento

	column freight
		dataType: double
		formatString: "$#,##0.00"
		displayFolder: Métricas
		summarizeBy: sum
		sourceColumn: freight

	column subtotal
		dataType: double
		formatString: "$#,##0.00"
		displayFolder: Métricas
		summarizeBy: sum
		sourceColumn: subtotal

	column total_venta
		dataType: double
		formatString: "$#,##0.00"
		displayFolder: Métricas
		summarizeBy: sum
		sourceColumn: total_venta

	column costo_total
		dataType: double
		formatString: "$#,##0.00"
		displayFolder: Métricas
		summarizeBy: sum
		sourceColumn: costo_total

	column margen
		dataType: double
		formatString: "$#,##0.00"
		displayFolder: Métricas
		summarizeBy: sum
		sourceColumn: margen

	column margen_pct
		dataType: double
		formatString: "0.00"
		displayFolder: Métricas
		summarizeBy: none
		sourceColumn: margen_pct

	column order_date
		dataType: dateTime
		formatString: "dd/MM/yyyy"
		displayFolder: Fechas
		summarizeBy: none
		sourceColumn: order_date

	column required_date
		dataType: dateTime
		formatString: "dd/MM/yyyy"
		isHidden
		displayFolder: Fechas
		summarizeBy: none
		sourceColumn: required_date

	column shipped_date
		dataType: dateTime
		formatString: "dd/MM/yyyy"
		displayFolder: Fechas
		summarizeBy: none
		sourceColumn: shipped_date

	column dias_entrega
		dataType: int64
		formatString: "#,##0"
		displayFolder: Métricas
		summarizeBy: none
		sourceColumn: dias_entrega

	column entrega_puntual
		dataType: boolean
		displayFolder: Métricas
		summarizeBy: none
		sourceColumn: entrega_puntual

/// ============================================================
/// TABLA DE MEDIDAS: _Medidas
/// Todas las medidas DAX agrupadas por pregunta de negocio
/// ============================================================
table _Medidas
	isHidden

	partition _Medidas = calculated
		mode: import
		source = ROW("placeholder", "x")

	/// P1 — Ventas por periodo
	measure 'Total Ventas' =
			SUM(fact_ventas[total_venta])
		formatString: "$#,##0.00"
		displayFolder: "P1 Ventas por Periodo"

	measure 'Num Ordenes' =
			DISTINCTCOUNT(fact_ventas[order_id])
		formatString: "#,##0"
		displayFolder: "P1 Ventas por Periodo"

	measure 'Ventas YTD' =
			CALCULATE(
			    [Total Ventas],
			    DATESYTD(dim_fecha[fecha_completa])
			)
		formatString: "$#,##0.00"
		displayFolder: "P1 Ventas por Periodo"

	measure 'Ventas Año Anterior' =
			CALCULATE(
			    [Total Ventas],
			    SAMEPERIODLASTYEAR(dim_fecha[fecha_completa])
			)
		formatString: "$#,##0.00"
		displayFolder: "P1 Ventas por Periodo"

	measure 'Variación YoY %' =
			VAR VentasActual  = [Total Ventas]
			VAR VentasAnterior = [Ventas Año Anterior]
			RETURN
			    IF(
			        ISBLANK(VentasAnterior) || VentasAnterior = 0,
			        BLANK(),
			        DIVIDE(VentasActual - VentasAnterior, VentasAnterior) * 100
			    )
		formatString: "0.00"
		displayFolder: "P1 Ventas por Periodo"

	/// P2 — Clientes rentables
	measure 'Clientes Activos' =
			DISTINCTCOUNT(fact_ventas[cliente_id])
		formatString: "#,##0"
		displayFolder: "P2 Clientes Rentables"

	measure 'Ventas por Cliente' =
			DIVIDE([Total Ventas], [Clientes Activos], 0)
		formatString: "$#,##0.00"
		displayFolder: "P2 Clientes Rentables"

	measure 'Ranking Cliente' =
			RANKX(
			    ALL(dim_cliente[company_name]),
			    [Total Ventas],
			    ,
			    DESC,
			    DENSE
			)
		formatString: "#,##0"
		displayFolder: "P2 Clientes Rentables"

	/// P3 — Productos más vendidos
	measure 'Unidades Vendidas' =
			SUM(fact_ventas[cantidad])
		formatString: "#,##0"
		displayFolder: "P3 Productos Vendidos"

	measure '% Contribución Ventas' =
			DIVIDE(
			    [Total Ventas],
			    CALCULATE([Total Ventas], ALL(dim_producto)),
			    0
			) * 100
		formatString: "0.00"
		displayFolder: "P3 Productos Vendidos"

	/// P4 — Análisis por categorías
	measure 'Ventas por Categoría' =
			CALCULATE(
			    [Total Ventas],
			    ALLEXCEPT(dim_producto, dim_producto[categoria])
			)
		formatString: "$#,##0.00"
		displayFolder: "P4 Categorías"

	/// P5 — Eficiencia de empleados
	measure 'Meta Periodo' =
			SUMX(
			    FILTER(
			        dim_metas_empleado,
			        dim_metas_empleado[empleado_id] = SELECTEDVALUE(dim_empleado[empleado_id])
			        && dim_metas_empleado[anio]     = SELECTEDVALUE(dim_fecha[anio])
			        && dim_metas_empleado[trimestre] = SELECTEDVALUE(dim_fecha[trimestre])
			    ),
			    dim_metas_empleado[meta_ventas_usd]
			)
		formatString: "$#,##0.00"
		displayFolder: "P5 Eficiencia Empleados"

	measure '% Cumplimiento Meta' =
			DIVIDE([Total Ventas], [Meta Periodo], 0) * 100
		formatString: "0.00"
		displayFolder: "P5 Eficiencia Empleados"

	measure 'Ranking Empleado' =
			RANKX(
			    ALL(dim_empleado[full_name]),
			    [Total Ventas],
			    ,
			    DESC,
			    DENSE
			)
		formatString: "#,##0"
		displayFolder: "P5 Eficiencia Empleados"

	/// P6 — Análisis de territorios
	measure 'Ventas por País' =
			CALCULATE(
			    [Total Ventas],
			    ALLEXCEPT(dim_territorio, dim_territorio[country])
			)
		formatString: "$#,##0.00"
		displayFolder: "P6 Territorios"

	measure '% Contribución Territorial' =
			DIVIDE(
			    [Total Ventas],
			    CALCULATE([Total Ventas], ALL(dim_territorio)),
			    0
			) * 100
		formatString: "0.00"
		displayFolder: "P6 Territorios"

	/// P7 — Tiempos de entrega
	measure 'Avg Dias Entrega' =
			AVERAGEX(
			    FILTER(
			        fact_ventas,
			        NOT ISBLANK(fact_ventas[dias_entrega])
			        && fact_ventas[dias_entrega] >= 0
			    ),
			    fact_ventas[dias_entrega]
			)
		formatString: "0.0"
		displayFolder: "P7 Tiempos Entrega"

	measure 'Pedidos Entregados' =
			COUNTROWS(
			    FILTER(fact_ventas, NOT ISBLANK(fact_ventas[shipped_date]))
			)
		formatString: "#,##0"
		displayFolder: "P7 Tiempos Entrega"

	measure 'Pedidos Pendientes' =
			COUNTROWS(
			    FILTER(fact_ventas, ISBLANK(fact_ventas[shipped_date]))
			)
		formatString: "#,##0"
		displayFolder: "P7 Tiempos Entrega"

	measure '% Entregas Puntuales' =
			VAR Puntuales =
			    COUNTROWS(
			        FILTER(
			            fact_ventas,
			            fact_ventas[entrega_puntual] = TRUE()
			        )
			    )
			VAR Entregados = [Pedidos Entregados]
			RETURN
			    DIVIDE(Puntuales, Entregados, 0) * 100
		formatString: "0.0"
		displayFolder: "P7 Tiempos Entrega"

	/// P8 — Margen de rentabilidad
	measure 'Total Margen' =
			SUM(fact_ventas[margen])
		formatString: "$#,##0.00"
		displayFolder: "P8 Margen Rentabilidad"

	measure 'Total Costo' =
			SUM(fact_ventas[costo_total])
		formatString: "$#,##0.00"
		displayFolder: "P8 Margen Rentabilidad"

	measure '% Margen Promedio' =
			DIVIDE([Total Margen], [Total Ventas], 0) * 100
		formatString: "0.00"
		displayFolder: "P8 Margen Rentabilidad"

	measure 'Ranking Margen Producto' =
			RANKX(
			    ALL(dim_producto[product_name]),
			    [Total Margen],
			    ,
			    DESC,
			    DENSE
			)
		formatString: "#,##0"
		displayFolder: "P8 Margen Rentabilidad"

	/// P9 — Clientes inactivos
	measure 'Última Compra Cliente' =
			CALCULATE(
			    MAX(fact_ventas[order_date]),
			    ALLEXCEPT(dim_cliente, dim_cliente[cliente_id])
			)
		formatString: "dd/MM/yyyy"
		displayFolder: "P9 Clientes Inactivos"

	measure 'Días Sin Comprar' =
			VAR UltimaFecha = [Última Compra Cliente]
			VAR FechaMax    = CALCULATE(MAX(fact_ventas[order_date]), ALL(fact_ventas))
			RETURN
			    IF(
			        ISBLANK(UltimaFecha),
			        BLANK(),
			        DATEDIFF(UltimaFecha, FechaMax, DAY)
			    )
		formatString: "#,##0"
		displayFolder: "P9 Clientes Inactivos"

	measure 'Es Cliente Inactivo' =
			IF([Días Sin Comprar] > 365, "Inactivo", "Activo")
		displayFolder: "P9 Clientes Inactivos"

	/// P10 — Estacionalidad
	measure 'Ventas por Trimestre' =
			CALCULATE(
			    [Total Ventas],
			    ALLEXCEPT(dim_fecha, dim_fecha[anio], dim_fecha[trimestre])
			)
		formatString: "$#,##0.00"
		displayFolder: "P10 Estacionalidad"

	measure 'Variación vs Trimestre Anterior' =
			VAR VentasActual = [Total Ventas]
			VAR VentasAnterior =
			    CALCULATE(
			        [Total Ventas],
			        DATEADD(dim_fecha[fecha_completa], -1, QUARTER)
			    )
			RETURN
			    DIVIDE(VentasActual - VentasAnterior, VentasAnterior, BLANK()) * 100
		formatString: "0.00"
		displayFolder: "P10 Estacionalidad"

	measure 'Índice Estacionalidad' =
			VAR VentasTrimestre = [Total Ventas]
			VAR VentasPromTrimestre =
			    AVERAGEX(
			        ALL(dim_fecha[trimestre]),
			        CALCULATE([Total Ventas])
			    )
			RETURN
			    DIVIDE(VentasTrimestre, VentasPromTrimestre, 0)
		formatString: "0.00"
		displayFolder: "P10 Estacionalidad"

relationship 'fv_fecha'
	fromColumn: fact_ventas.fecha_id
	toColumn: dim_fecha.fecha_id

relationship 'fv_fecha_entrega'
	fromColumn: fact_ventas.fecha_entrega_id
	toColumn: dim_fecha.fecha_id
	isActive: false

relationship 'fv_cliente'
	fromColumn: fact_ventas.cliente_id
	toColumn: dim_cliente.cliente_id

relationship 'fv_empleado'
	fromColumn: fact_ventas.empleado_id
	toColumn: dim_empleado.empleado_id

relationship 'fv_producto'
	fromColumn: fact_ventas.producto_id
	toColumn: dim_producto.producto_id

relationship 'fv_shipper'
	fromColumn: fact_ventas.shipper_id
	toColumn: dim_shipper.shipper_id

relationship 'fv_territorio'
	fromColumn: fact_ventas.territorio_id
	toColumn: dim_territorio.territorio_id

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBI_ProTooling = ["DevMode"]

ref cultureInfo es-CO

