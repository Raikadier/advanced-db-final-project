	column phone
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: phone

/// ============================================================
/// DIMENSIÓN: dim_territorio
/// Fuente: ShipCountry único de Orders + mapa de zonas
/// Responde: P6 (análisis territorial), P7 (entrega por región)
/// ============================================================
table dim_territorio

	partition 'dim_territorio-m' = m
		mode: import
		source = ```
			let
			    Source  = Sql.Database("(localdb)\\MSSQLLocalDB", "Northwind"),
			    Orders  = Source{[Schema="dbo", Item="Orders"]}[Data],
			    Sel     = Table.SelectColumns(Orders, {"ShipCountry", "ShipRegion"}),
			    Unique  = Table.Distinct(Sel),
			    WithId  = Table.AddColumn(Unique, "territorio_id",
			        each Text.Upper(Text.Start([ShipCountry], 3)) & "-" &
			             Text.Upper(Text.Start(
			                 if [ShipRegion] = null then "XX" else [ShipRegion],
			                 2)),
			        type text),
			    WithZone = Table.AddColumn(WithId, "zona", each "Ver dashboard", type text),
			    WithCont = Table.AddColumn(WithZone, "continente", each "Ver dashboard", type text),
			    Renamed = Table.RenameColumns(WithCont, {
			        {"ShipCountry", "country"},
			        {"ShipRegion",  "region"}
			    })
			in
			    Renamed
			```

	column territorio_id
		dataType: string
		isKey
		displayFolder: Claves
		summarizeBy: none
		sourceColumn: territorio_id

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country
		dataCategory: Country

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column continente
		dataType: string
		summarizeBy: none
		sourceColumn: continente

	column zona
		dataType: string
		summarizeBy: none
		sourceColumn: zona

	hierarchy 'Jerarquía Territorial'
		level Continente
			column: continente
		level Zona
			column: zona
		level País
			column: country

/// ============================================================
/// DIMENSIÓN: dim_metas_empleado
/// Tabla calculada DAX — metas de ventas trimestrales por cargo
/// Responde: P5 (eficiencia vs. metas)
/// ============================================================
table dim_metas_empleado
	isHidden

	partition 'dim_metas_empleado-calc' = calculated
		mode: import
		source = ```
			SELECTCOLUMNS(
			    GENERATE(
			        GENERATE(
			            DATATABLE(
			                "empleado_id", INTEGER,
			                "title",       STRING,
			                {
			                    {1, "Sales Representative"},
			                    {2, "Vice President, Sales"},
			                    {3, "Sales Representative"},
			                    {4, "Sales Representative"},
			                    {5, "Sales Manager"},
			                    {6, "Sales Representative"},
			                    {7, "Sales Representative"},
			                    {8, "Sales Representative"},
			                    {9, "Sales Representative"}
			                }
			            ),
			            DATATABLE("anio", INTEGER, {{1996}, {1997}, {1998}})
			        ),
			        DATATABLE("trimestre", INTEGER, {{1}, {2}, {3}, {4}})
			    ),
			    "empleado_id", [empleado_id],
			    "anio",        [anio],
			    "trimestre",   [trimestre],
			    "meta_ventas_usd",
			        IF([title] = "Vice President, Sales", 18000.0,
			        IF([title] = "Sales Manager",         15000.0,
			                                              12000.0)),
			    "categoria_meta",
			        IF([title] = "Vice President, Sales", "Agresiva",
			        IF([title] = "Sales Manager",         "Estándar",
			                                              "Básica"))
			)
			```

	column empleado_id
		dataType: int64
		isKey
		displayFolder: Claves
		summarizeBy: none
		sourceColumn: empleado_id

	column anio
		dataType: int64
		summarizeBy: none
		sourceColumn: anio

	column trimestre
		dataType: int64
		summarizeBy: none
		sourceColumn: trimestre

	column meta_ventas_usd
		dataType: double
		formatString: "$#,##0.00"
		summarizeBy: sum
		sourceColumn: meta_ventas_usd

	column categoria_meta
		dataType: string
		summarizeBy: none
		sourceColumn: categoria_meta

/// ============================================================
/// TABLA DE HECHOS: fact_ventas
/// Fuente: Orders JOIN Order Details — ~2155 registros
/// Granularidad: 1 fila = 1 línea de detalle de pedido
/// Responde: P1 a P10 (todas las preguntas)
/// ============================================================
table fact_ventas

	partition 'fact_ventas-m' = m
		mode: import
		source = ```
			let
			    Source      = Sql.Database("(localdb)\\MSSQLLocalDB", "Northwind"),
			    Orders      = Source{[Schema="dbo", Item="Orders"]}[Data],
			    OrderDetails= Source{[Schema="dbo", Item="Order Details"]}[Data],
			    OrdSel = Table.SelectColumns(Orders, {
			        "OrderID", "CustomerID", "EmployeeID",
			        "OrderDate", "RequiredDate", "ShippedDate",
			        "ShipVia", "Freight", "ShipCountry", "ShipRegion"
			    }),
			    ODSel = Table.SelectColumns(OrderDetails, {
			        "OrderID", "ProductID", "UnitPrice", "Quantity", "Discount"
			    }),
			    Joined = Table.NestedJoin(
			        ODSel, "OrderID",
			        OrdSel, "OrderID",
			        "OrdData", JoinKind.Inner
			    ),
			    Exp = Table.ExpandTableColumn(Joined, "OrdData", {
			        "CustomerID", "EmployeeID", "OrderDate", "RequiredDate",
			        "ShippedDate", "ShipVia", "Freight", "ShipCountry", "ShipRegion"
			    }),
			    Subtotal    = Table.AddColumn(Exp, "subtotal",
			        each [UnitPrice] * [Quantity], type number),
			    TotalVenta  = Table.AddColumn(Subtotal, "total_venta",
			        each [subtotal] * (1 - [Discount]), type number),
			    CostoUnit   = Table.AddColumn(TotalVenta, "costo_adquisicion_unit",
			        each [UnitPrice] * 0.60, type number),
			    CostoTotal  = Table.AddColumn(CostoUnit, "costo_total",
			        each [costo_adquisicion_unit] * [Quantity], type number),
			    Margen      = Table.AddColumn(CostoTotal, "margen",
			        each [total_venta] - [costo_total], type number),
			    MargenPct   = Table.AddColumn(Margen, "margen_pct",
			        each if [total_venta] = 0 then 0 else [margen] / [total_venta] * 100, type number),
			    DiasEntrega = Table.AddColumn(MargenPct, "dias_entrega",
			        each if [ShippedDate] = null then null
			             else Duration.Days([ShippedDate] - [OrderDate]),
			        type number),
			    EntPuntual  = Table.AddColumn(DiasEntrega, "entrega_puntual",
			        each if [ShippedDate] = null then null
			             else [ShippedDate] <= [RequiredDate],
			        type logical),
			    FechaId     = Table.AddColumn(EntPuntual, "fecha_id",
			        each if [OrderDate] = null then null
			             else Date.ToText([OrderDate], "yyyyMMdd"),
			        type text),
			    FechaEntId  = Table.AddColumn(FechaId, "fecha_entrega_id",
			        each if [ShippedDate] = null then null
			             else Date.ToText([ShippedDate], "yyyyMMdd"),
			        type text),
			    DetailId    = Table.AddColumn(FechaEntId, "order_detail_id",
			        each Text.From([OrderID]) & "-" & Text.From([ProductID]),
			        type text),
			    ShipCntry   = Table.AddColumn(DetailId, "ship_country_safe",
			        each if [ShipCountry] = null then "UNK" else [ShipCountry],
			        type text),
			    ShipReg     = Table.AddColumn(ShipCntry, "ship_region_safe",
			        each if [ShipRegion] = null then "XX" else [ShipRegion],
			        type text),
			    TerrId      = Table.AddColumn(ShipReg, "territorio_id",
			        each Text.Upper(Text.Start([ship_country_safe], 3)) & "-" &
			             Text.Upper(Text.Start([ship_region_safe], 2)),
			        type text),
			    Round2 = Table.TransformColumns(TerrId, {
			        {"subtotal",    each Number.Round(_, 2), type number},
			        {"total_venta", each Number.Round(_, 2), type number},
			        {"costo_total", each Number.Round(_, 2), type number},
			        {"margen",      each Number.Round(_, 2), type number},
			        {"margen_pct",  each Number.Round(_, 2), type number},
			        {"Freight",     each Number.Round(_, 2), type number}
			    }),
			    Final = Table.RenameColumns(Round2, {
			        {"OrderID",     "order_id"},
			        {"CustomerID",  "cliente_id"},
			        {"EmployeeID",  "empleado_id"},
			        {"ProductID",   "producto_id"},
			        {"ShipVia",     "shipper_id"},
			        {"UnitPrice",   "unit_price"},
			        {"Quantity",    "cantidad"},
			        {"Discount",    "descuento"},
			        {"Freight",     "freight"},
			        {"OrderDate",   "order_date"},
			        {"RequiredDate","required_date"},
			        {"ShippedDate", "shipped_date"}
			    }),
			    Columnas = Table.SelectColumns(Final, {
			        "order_detail_id", "order_id",
			        "fecha_id", "fecha_entrega_id",
			        "cliente_id", "empleado_id", "producto_id",
			        "shipper_id", "territorio_id",
			        "cantidad", "unit_price", "descuento", "freight",
			        "subtotal", "total_venta",
			        "costo_total", "margen", "margen_pct",
			        "order_date", "required_date", "shipped_date",
			        "dias_entrega", "entrega_puntual"
			    })
			in
			    Columnas
			```

	column order_detail_id
		dataType: string
		isKey
		displayFolder: Claves
		summarizeBy: none
		sourceColumn: order_detail_id

	column order_id
		dataType: int64
