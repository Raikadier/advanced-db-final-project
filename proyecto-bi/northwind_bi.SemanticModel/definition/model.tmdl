model Model
	culture: es-CO
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// ============================================================
/// DIMENSIÓN: dim_fecha
/// Tabla calculada DAX — cubre el rango histórico Northwind
/// Responde: P1 (ventas por periodo), P10 (estacionalidad)
/// ============================================================
table dim_fecha
	isHidden

	partition 'dim_fecha-calc' = calculated
		mode: import
		source = ```
			VAR FechaBase =
			    CALENDAR( DATE(1996, 7, 4), DATE(1998, 5, 6) )
			RETURN
			    ADDCOLUMNS(
			        FechaBase,
			        "fecha_id",         FORMAT([Date], "YYYYMMDD"),
			        "anio",             YEAR([Date]),
			        "trimestre",        QUARTER([Date]),
			        "mes",              MONTH([Date]),
			        "nombre_mes",       FORMAT([Date], "MMMM"),
			        "semana_anio",      WEEKNUM([Date], 2),
			        "dia",              DAY([Date]),
			        "nombre_dia",       FORMAT([Date], "DDDD"),
			        "es_fin_semana",    IF(WEEKDAY([Date], 2) >= 6, TRUE(), FALSE())
			    )
			```

	column fecha_id
		dataType: string
		isKey
		displayFolder: Claves
		summarizeBy: none
		sourceColumn: fecha_id

	column fecha_completa
		dataType: dateTime
		formatString: "dd/MM/yyyy"
		summarizeBy: none
		sourceColumn: Date

	column anio
		dataType: int64
		summarizeBy: none
		sourceColumn: anio

	column trimestre
		dataType: int64
		summarizeBy: none
		sourceColumn: trimestre

	column mes
		dataType: int64
		summarizeBy: none
		sourceColumn: mes

	column nombre_mes
		dataType: string
		sortByColumn: mes
		summarizeBy: none
		sourceColumn: nombre_mes

	column semana_anio
		dataType: int64
		summarizeBy: none
		sourceColumn: semana_anio

	column dia
		dataType: int64
		summarizeBy: none
		sourceColumn: dia

	column nombre_dia
		dataType: string
		summarizeBy: none
		sourceColumn: nombre_dia

	column es_fin_semana
		dataType: boolean
		summarizeBy: none
		sourceColumn: es_fin_semana

	hierarchy 'Jerarquía Temporal'
		level Año
			column: anio
		level Trimestre
			column: trimestre
		level Mes
			column: nombre_mes
		level Día
			column: dia

/// ============================================================
/// DIMENSIÓN: dim_cliente
/// Fuente: Northwind.Customers (91 registros, 21 países)
/// Responde: P2 (clientes rentables), P6 (geografía), P9 (inactivos)
/// ============================================================
table dim_cliente

	partition 'dim_cliente-m' = m
		mode: import
		source = ```
			let
			    Source   = Sql.Database("(localdb)\\MSSQLLocalDB", "Northwind"),
			    Clientes = Source{[Schema="dbo", Item="Customers"]}[Data],
			    Sel = Table.SelectColumns(Clientes, {
			        "CustomerID", "CompanyName", "ContactName", "ContactTitle",
			        "Address", "City", "Region", "PostalCode", "Country",
			        "Phone", "Fax"
			    }),
			    Renamed = Table.RenameColumns(Sel, {
			        {"CustomerID",   "cliente_id"},
			        {"CompanyName",  "company_name"},
			        {"ContactName",  "contact_name"},
			        {"ContactTitle", "contact_title"},
			        {"Address",      "address"},
			        {"City",         "city"},
			        {"Region",       "region"},
			        {"PostalCode",   "postal_code"},
			        {"Country",      "country"},
			        {"Phone",        "phone"},
			        {"Fax",          "fax"}
			    })
			in
			    Renamed
			```

	column cliente_id
		dataType: string
		isKey
		displayFolder: Claves
		summarizeBy: none
		sourceColumn: cliente_id

	column company_name
		dataType: string
		summarizeBy: none
		sourceColumn: company_name

	column contact_name
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: contact_name

	column contact_title
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: contact_title

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city
		dataCategory: City

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country
		dataCategory: Country

	column address
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: address

	column postal_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: postal_code

	column phone
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: phone

	column fax
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: fax

	hierarchy 'Jerarquía Geográfica Cliente'
		level País
			column: country
		level Ciudad
			column: city
		level Cliente
			column: company_name

/// ============================================================
/// DIMENSIÓN: dim_empleado
/// Fuente: Northwind.Employees (9 registros)
/// Responde: P5 (eficiencia vendedores), P6 (territorios)
/// ============================================================
table dim_empleado

	partition 'dim_empleado-m' = m
		mode: import
		source = ```
			let
			    Source    = Sql.Database("(localdb)\\MSSQLLocalDB", "Northwind"),
			    Empleados = Source{[Schema="dbo", Item="Employees"]}[Data],
			    Sel = Table.SelectColumns(Empleados, {
			        "EmployeeID", "LastName", "FirstName", "Title",
			        "TitleOfCourtesy", "HireDate", "City", "Region",
			        "Country", "ReportsTo"
			    }),
			    Renamed = Table.RenameColumns(Sel, {
			        {"EmployeeID",       "empleado_id"},
			        {"LastName",         "last_name"},
			        {"FirstName",        "first_name"},
			        {"Title",            "title"},
			        {"TitleOfCourtesy",  "title_of_courtesy"},
			        {"HireDate",         "hire_date"},
			        {"City",             "city"},
			        {"Region",           "region"},
			        {"Country",          "country"},
			        {"ReportsTo",        "reports_to"}
			    }),
			    FullName = Table.AddColumn(Renamed, "full_name",
			        each [first_name] & " " & [last_name], type text)
			in
			    FullName
			```

	column empleado_id
		dataType: int64
		isKey
		displayFolder: Claves
		summarizeBy: none
		sourceColumn: empleado_id

	column last_name
		dataType: string
