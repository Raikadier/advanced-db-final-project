		summarizeBy: none
		sourceColumn: title

	column title_of_courtesy
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: title_of_courtesy

	column hire_date
		dataType: dateTime
		formatString: "dd/MM/yyyy"
		isHidden
		summarizeBy: none
		sourceColumn: hire_date

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column country
		dataType: string
		summarizeBy: none
