	hierarchy 'Jerarquía Geográfica Cliente'
		lineageTag: 4f70b033-64a0-49a4-a9fd-e39f5c9692a2

		level País
			lineageTag: 4f14a207-fd68-4e4c-b640-dfed12916c7e
