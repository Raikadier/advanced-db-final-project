# Copiar a .env y completar valores reales. NUNCA commitear .env
# Ver README.md → "Variables de entorno"

# Supabase northwind-oltp (fuente)
SOURCE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase northwind-staging
STAGING_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# MongoDB Atlas
MONGO_URI=mongodb+srv://etl_northwind:[PASSWORD]@[CLUSTER].mongodb.net/?retryWrites=true&w=majority
MONGO_DB=northwind_dw

# Control ETL
BATCH_SIZE=500
TRUNCATE_FIRST=true
VALIDATE_DATA=true
LOG_LEVEL=INFO
